# 값은 Vercel 프로젝트 환경 변수에만 넣는다. 이 파일에는 이름만 둔다.
# 로컬에서 필요하면 .env.local 로 복사해 값을 채운다(.gitignore 대상).
DATABASE_URL=
ENTRY_KEY=
# true 면 입장 키 없이 기본 주소로 들어온다(관리자 설정이 우선). 비우면 입장 키 필요
OPEN_ENTRY=
ADMIN_PASSWORD_FULL=
ADMIN_PASSWORD_READONLY=
SESSION_SECRET=
# (선택) 비밀 관리자 링크 키 — /admin?a=키 로 연 브라우저만 로그인 화면이 보인다. 관리자 화면에서 만든 링크가 우선
ADMIN_LINK_KEY=
APP_VERSION=
